+   * @param sess the session to use
+   * @param buf the buffer to send data from
+   * @param buf_size the size of the buffer
+   * @return -1 on fatal error, -2 on more would-be blocking operation needed,
+   * else size of data sent
+   * @note MHD never invokes this callback with @a buf_size > INT_MAX.
+   */
+  int
+  (*conn_send)(void *sess, const void *buf, size_t buf_size);
+
+  /**
