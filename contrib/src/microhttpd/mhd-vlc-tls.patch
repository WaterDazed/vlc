+
+/**
+ * @file test_external_tls.c
+ * @brief  test with client against dummy external TLS server
+ * @author Ayush Dey
+ */
+#define MHD_APP_DAEMON_EXTRN_TLS_CNTX_TYPE void
+
+#include "libtest.h"
+
+#include "mhd_sockets_macros.h"
+
+// store TLS callbacks invocation count
+struct MHDT_external_tls_TestStats
+{
+  int daemon_init_calls;
+  int daemon_deinit_calls;
+  int conn_init_calls;
+  int conn_deinit_calls;
+  int conn_recv_calls;
+  int conn_send_calls;
+};
+
+static struct MHDT_external_tls_TestStats g_test_stats;
+
+static void MHDT_reset_test_stats(void)
+{
+  memset(&g_test_stats, 0, sizeof(g_test_stats));
+}
+
+// dummy structure to hold external TLS daemon data
+struct MHDT_ExternalDaemonData
+{
+  void *ctx;
+  const char *cert;
+  const char *key;
+};
+
+// dummy structure to hold external TLS connection data
+struct MHDT_ExternalConnData
+{
+  void *cred;
+  int fd;
+};
+
+static void* MHDT_daemon_init(void *ctx, const char *cert, const char *key)
+{
+  g_test_stats.daemon_init_calls++;
+
+  struct MHDT_ExternalDaemonData *cred;
+
+  cred = (struct MHDT_ExternalDaemonData *) malloc(sizeof(struct MHDT_ExternalDaemonData));
+  if (NULL == cred)
+    return NULL;
+
+  cred->ctx = ctx;
+  cred->cert = cert;
+  cred->key = key;
+
+  // Here you would typically initialize the TLS daemon with ctx, cert and key
+  // For this test, we just return the daemon credentials object
+
+  return cred;
+}
+
+static void MHDT_daemon_deinit(void *cred)
+{
+  g_test_stats.daemon_deinit_calls++;
+  struct MHDT_ExternalDaemonData *c = (struct MHDT_ExternalDaemonData *) cred;
+
+  if (NULL != c)
+  {
+    // For this test, we just free the credentials object
+    free(c);
+  }
+  return;
+}
+
+static void* MHDT_conn_init(void *cred, int fd, const char *const *alpn)
+{
+  g_test_stats.conn_init_calls++;
+  struct MHDT_ExternalConnData *sess;
+
+  sess = (struct MHDT_ExternalConnData *) malloc(sizeof(struct MHDT_ExternalConnData));
+  if (NULL == sess)
+    return NULL;
+
+  sess->cred = cred;
+  sess->fd = fd;
+
+  // Here you would typically initialize the TLS session with the credentials
+  // For this test, we just return the session object
+
+  return sess;
+}
+
+static void MHDT_conn_deinit(void *sess)
+{
+  g_test_stats.conn_deinit_calls++;
+  struct MHDT_ExternalConnData *c = (struct MHDT_ExternalConnData *) sess;
+
+  if (NULL != c)
+  {
+    // For this test, we just free the session object
+    free(c);
+  }
+  return;
+}
+
+static int MHDT_conn_handshake(void *cred, void *sess)
+{
+  // This is a dummy handshake implementation. Always succeeds as additional handshake
+  // operations are not needed for plain TCP operations.
+  return 0;
+}
+
+static int MHDT_conn_shutdown(void *sess, int duplex)
+{
+  // This is a dummy shutdown implementation. Always succeeds as additional shutdown
+  // operations are not needed for plain TCP operations.
+  return 0;
+}
+
+static int MHDT_conn_recv(void *sess, void *buf, size_t buf_size)
+{
+  g_test_stats.conn_recv_calls++;
+  int res;
+  struct MHDT_ExternalConnData *c = (struct MHDT_ExternalConnData *) sess;
+
+  res = mhd_sys_recv (c->fd, buf, buf_size);
+  if (res < 0)
+  {
+    // as edge triggering is not supported in external TLS, we can return -2
+    // to indicate that more would-be blocking operation is needed
+    // for both EAGAIN and EINTR errors
+    if ( mhd_SCKT_ERR_IS_EAGAIN (mhd_SCKT_GET_LERR()) || mhd_SCKT_ERR_IS_EINTR (mhd_SCKT_GET_LERR()) )
+      return -2; // More would-be blocking operation needed
+    else
+      return -1; // Fatal error
+  }
+  return res;
+}
+
+static int MHDT_conn_has_data_in(void *sess)
+{
+  return 0; // For plain TCP, we do not have a buffer to check
+  // In a real TLS implementation, you would check if the TLS buffer has data
+}
+
+static int MHDT_conn_send(void *sess, const void *buf, size_t buf_size)
+{
+  g_test_stats.conn_send_calls++;
+  int res;
+  struct MHDT_ExternalConnData *c = (struct MHDT_ExternalConnData *) sess;
+
+  res = mhd_sys_send(c->fd, buf, buf_size);
+  if (res < 0)
+  {
+    // as edge triggering is not supported in external TLS, we can return -2
+    // to indicate that more would-be blocking operation is needed
+    // for both EAGAIN and EINTR errors
+    if ( mhd_SCKT_ERR_IS_EAGAIN (mhd_SCKT_GET_LERR()) || mhd_SCKT_ERR_IS_EINTR (mhd_SCKT_GET_LERR()) )
+      return -2; // More would-be blocking operation needed
+    else
+      return -1; // Fatal error
+  }
+  return res;
+}
+
+static enum MHD_TlsVersion MHDT_conn_get_tls_ver(void *sess)
+{
+  return MHD_TLS_VERSION_NO_TLS; // For plain TCP, we do not have a TLS version
+  // In a real TLS implementation, you would return the TLS version of the session
+  // @see enum MHD_TlsVersion
+}
+
+const struct MHD_DaemonTLSCallbacks tls_cbs =
+{
