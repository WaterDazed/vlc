+++ microhttpd/src/mhd2/tls_external_funcs.c
@@ -0,0 +1,518 @@
+/*
+  This file is part of GNU libmicrohttpd
+  Copyright (C) 2024 Evgeny Grin (Karlson2k) (and other contributing authors)
+
+  GNU libmicrohttpd is free software; you can redistribute it and/or
