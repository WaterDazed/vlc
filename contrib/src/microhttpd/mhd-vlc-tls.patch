+  License along with this library; if not, write to the Free Software
+  Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
+
+*/
+
+/**
+ * @file src/mhd2/tls_external_funcs.c
+ * @brief  The implementation of external TLS functions
+ * @author Ayush Dey
+ */
+
+#include "mhd_sys_options.h"
+
+#include "sys_bool_type.h"
+#include "sys_base_types.h"
+
+#include "compat_calloc.h"
+#include "sys_malloc.h"
+#include "mhd_assert.h"
+#include "mhd_limits.h"
+
+#include <string.h>
+
+#include "mhd_conn_socket.h"
+
+#include "mhd_tls_ver_stct.h"
+
+#include "tls_external_daemon_data.h"
+#include "tls_external_conn_data.h"
+#include "tls_external_funcs.h"
+
+#include "daemon_options.h"
+#include "daemon_logger.h"
+
+#include "mhd_public_api.h"
+
+/* ** Global initialisation / de-initialisation ** */
+
+static bool external_lib_inited = false;
+
+MHD_INTERNAL void
+mhd_tls_external_global_init (void)
+{
+  external_lib_inited = true;
+}
+
+
+MHD_INTERNAL void
+mhd_tls_external_global_deinit (void)
+{
+  external_lib_inited = false;
+}
+
+
+MHD_INTERNAL MHD_FN_PURE_ bool
+mhd_tls_external_is_inited_fine (void)
+{
+  return external_lib_inited;
+}
+
+/* ** Daemon initialisation / de-initialisation ** */
+
+/**
+ * Check application-provided daemon TLS settings
+ * @param d the daemon handle
+ * @param s the application-provided settings
+ * @return #MHD_SC_OK on success,
+ *         error code otherwise
+ */
+static MHD_FN_PAR_NONNULL_ALL_ MHD_FN_MUST_CHECK_RESULT_ enum MHD_StatusCode
+check_app_tls_sessings (struct MHD_Daemon *restrict d,
+                        bool sk_edge_trigg,
+                        struct DaemonOptions *restrict s)
+{
+  mhd_assert (MHD_TLS_BACKEND_NONE != s->tls);
+  mhd_assert ((MHD_TLS_BACKEND_EXTERNAL == s->tls) || \
+              (MHD_TLS_BACKEND_ANY == s->tls));
+  if (NULL == s->tls_cert_key.v_mem_cert)
+  {
+    mhd_LOG_MSG (d, MHD_SC_TLS_CONF_BAD_CERT, \
+                 "No valid TLS certificate is provided");
+    return MHD_SC_TLS_CONF_BAD_CERT;
+  }
+  mhd_assert (NULL != s->tls_cert_key.v_mem_key);
+
+  if (sk_edge_trigg)
+  {
+    mhd_LOG_MSG (d, MHD_SC_TLS_BACKEND_DAEMON_INCOMPATIBLE_SETTINGS, \
+                 "Edge-triggered sockets polling cannot be used "
+                 "with External backend");
+    return MHD_SC_TLS_BACKEND_DAEMON_INCOMPATIBLE_SETTINGS;
+  }
+
+  return MHD_SC_OK;
+}
+
+static MHD_FN_PAR_NONNULL_ALL_ MHD_FN_MUST_CHECK_RESULT_ enum MHD_StatusCode
+daemon_init_credentials (struct MHD_Daemon *restrict d,
+                         struct mhd_TlsExternalDaemonData *restrict d_tls,
+                         struct DaemonOptions *restrict s)
+{
+  size_t cert_len;
+  size_t key_len;
+
+  cert_len = strlen (s->tls_cert_key.v_mem_cert);
+  key_len = strlen (s->tls_cert_key.v_mem_key);
+
+  mhd_assert (0 != cert_len);
+  mhd_assert (0 != key_len);
+
+  if ((cert_len != (unsigned int) cert_len)
+      || (key_len != (unsigned int) key_len))
+    return MHD_SC_TLS_CONF_BAD_CERT; /* Very unlikely, do not waste space on special message */
+
+  if (NULL == s->external_tls_data.v_tls_cbs)
+  {
+    mhd_LOG_MSG (d, MHD_SC_TLS_EXTERNAL_DATA_UNAVAILABLE, \
+                 "No valid TLS callbacks are provided");
+    return MHD_SC_TLS_EXTERNAL_DATA_UNAVAILABLE;
+  }
+
+  d_tls->cbs = s->external_tls_data.v_tls_cbs;
+
+  d_tls->cred = d_tls->cbs->daemon_init(s->external_tls_data.v_ctx, s->tls_cert_key.v_mem_cert, s->tls_cert_key.v_mem_key);
+
+  if (NULL == d_tls->cred)
+  {
+    mhd_LOG_MSG (d, MHD_SC_TLS_DAEMON_INIT_FAILED, \
+      "Failed to initialise TLS credentials for the daemon");
+
+    return MHD_SC_TLS_DAEMON_INIT_FAILED;
+  }
+
+  return MHD_SC_OK;
+}
+
+static MHD_FN_PAR_NONNULL_ALL_ void
+daemon_deinit_credentials (struct mhd_TlsExternalDaemonData *restrict d_tls)
+{
+  mhd_assert (NULL != d_tls->cred);
+  d_tls->cbs->daemon_deinit(d_tls->cred);
+}
+
+MHD_INTERNAL MHD_FN_MUST_CHECK_RESULT_ MHD_FN_PAR_NONNULL_ALL_
+MHD_FN_PAR_OUT_ (3) mhd_StatusCodeInt
+mhd_tls_external_daemon_init (struct MHD_Daemon *restrict d,
+                               bool sk_edge_trigg,
+                               struct DaemonOptions *restrict s,
+                               struct mhd_TlsExternalDaemonData **restrict p_d_tls)
+{
+  mhd_StatusCodeInt res;
+  struct mhd_TlsExternalDaemonData *restrict d_tls;
+
+  mhd_assert (external_lib_inited);
+
+  res = check_app_tls_sessings (d, sk_edge_trigg, s);
+  if (MHD_SC_OK != res)
+    return res;
+
+  d_tls = (struct mhd_TlsExternalDaemonData *)
+          mhd_calloc (1, sizeof (struct mhd_TlsExternalDaemonData));
+
+  *p_d_tls = d_tls;
+  if (NULL == d_tls)
+    return MHD_SC_DAEMON_MEM_ALLOC_FAILURE;
+
+  res = daemon_init_credentials(d, d_tls, s);
+  if (MHD_SC_OK == res)
+    return res; /* Success exit point */
+
+  free (d_tls);
+  *p_d_tls = NULL;
+  mhd_assert (MHD_SC_OK != res);
+  return res;
+}
+
+MHD_INTERNAL MHD_FN_PAR_NONNULL_ALL_
+MHD_FN_PAR_INOUT_ (1) void
+mhd_tls_external_daemon_deinit (struct mhd_TlsExternalDaemonData *restrict d_tls)
+{
+  mhd_assert (NULL != d_tls);
+  daemon_deinit_credentials (d_tls);
+  free (d_tls);
+}
+
+/* ** Connection initialisation / de-initialisation ** */
+
+MHD_INTERNAL size_t
+mhd_tls_external_conn_get_tls_size_v (void)
+{
+  return sizeof (struct mhd_TlsExternalConnData);
+}
+
+MHD_INTERNAL MHD_FN_MUST_CHECK_RESULT_ MHD_FN_PAR_NONNULL_ALL_
+MHD_FN_PAR_OUT_ (3) bool
+mhd_tls_external_conn_init (const struct mhd_TlsExternalDaemonData *restrict d_tls,
+                            const struct mhd_ConnSocket *sk,
+                            struct mhd_TlsExternalConnData *restrict c_tls)
+{
+  int fd;
+  const char *alpn[] = { "http/1.0", "http/1.1", NULL };
+
+  c_tls->cred = d_tls->cred;
+  c_tls->rmt_shut_tls_wr = false;
+  c_tls->cbs = d_tls->cbs;
+
+#ifndef NDEBUG
+  c_tls->dbg.is_inited = false;
+  c_tls->dbg.is_tls_handshake_completed = false;
+  c_tls->dbg.is_finished = false;
+  c_tls->dbg.is_failed = false;
+#endif /* ! NDEBUG */
+
+  fd = (int) sk->fd;
+  if (sk->fd != (MHD_Socket) fd)
+    return false;
+
+  c_tls->sess = d_tls->cbs->conn_init(d_tls->cred, fd, alpn);
+
+  if (c_tls->sess == NULL)
+    return false;
+
+#ifndef NDEBUG
+      c_tls->dbg.is_inited = true;
+#endif /* ! NDEBUG */
+  return true;
+}
+
+MHD_INTERNAL MHD_FN_PAR_NONNULL_ALL_ void
+mhd_tls_external_conn_deinit (struct mhd_TlsExternalConnData *restrict c_tls)
+{
+  mhd_assert (NULL != c_tls->sess);
+  mhd_assert (c_tls->dbg.is_inited);
+  c_tls->cbs->conn_deinit(c_tls->sess);
+}
+
+/* ** TLS connection establishing ** */
+
+MHD_INTERNAL MHD_FN_MUST_CHECK_RESULT_ MHD_FN_PAR_NONNULL_ALL_
+enum mhd_TlsProcedureResult
+mhd_tls_external_conn_handshake (struct mhd_TlsExternalConnData *restrict c_tls)
+{
+  int res;
+
+  mhd_assert (c_tls->dbg.is_inited);
+  mhd_assert (! c_tls->dbg.is_tls_handshake_completed);
+  mhd_assert (! c_tls->dbg.is_finished);
+  mhd_assert (! c_tls->dbg.is_failed);
+
+  res = c_tls->cbs->conn_handshake(c_tls->cred, c_tls->sess);
+
+  switch (res)
+  {
+  case 0:
+#ifndef NDEBUG
+    c_tls->dbg.is_tls_handshake_completed = true;
+#endif /* ! NDEBUG */
+    return mhd_TLS_PROCED_SUCCESS;
+  case 1:
+    /* Externally provided TLS might not be able to distinguish between "interrupted"
+       and "try again" codes.
+       If edge-triggered sockets polling is used and the flag is cleared, but
+       it should not (because the process has been "interrupted") then already
+       pending data could be never processed.
+       If the flag is not cleared, but it should be cleared (because all
+       received data has been processed) then it would create busy-waiting loop
+       with edge-triggered sockets polling.
+       Temporal solution: disallow edge-triggered sockets polling with External TLS
+       backend and use clear of "ready" flag. */
+    return mhd_TLS_PROCED_RECV_MORE_NEEDED;
+  case 2:
+    /* Externally provided TLS might not be able to distinguish between "interrupted"
+       and "try again" codes.
+       If edge-triggered sockets polling is used and the flag is cleared, but
+       it should not (because the process has been "interrupted") then already
+       pending data could be never processed.
+       If the flag is not cleared, but it should be cleared (because all
+       received data has been processed) then it would create busy-waiting loop
+       with edge-triggered sockets polling.
+       Temporal solution: disallow edge-triggered sockets polling with External TLS
+       backend and use clear of "ready" flag. */
+    return mhd_TLS_PROCED_SEND_MORE_NEEDED;
+  default:
+    break;
+  }
+#ifndef NDEBUG
+  c_tls->dbg.is_failed = true;
+#endif /* ! NDEBUG */
+  return mhd_TLS_PROCED_FAILED;
+}
+
+MHD_INTERNAL MHD_FN_MUST_CHECK_RESULT_ MHD_FN_PAR_NONNULL_ALL_
+enum mhd_TlsProcedureResult
+mhd_tls_external_conn_shutdown (struct mhd_TlsExternalConnData *restrict c_tls)
+{
+  int res;
+  bool duplex = c_tls->rmt_shut_tls_wr ? false : true;
+
+  mhd_assert (c_tls->dbg.is_inited);
+  mhd_assert (c_tls->dbg.is_tls_handshake_completed);
+  mhd_assert (! c_tls->dbg.is_finished);
+  mhd_assert (! c_tls->dbg.is_failed);
+
+  res = c_tls->cbs->conn_shutdown(c_tls->sess, duplex);
+
+  switch (res)
+  {
+  case 0:
+#ifndef NDEBUG
+    c_tls->dbg.is_finished = true;
+#endif /* ! NDEBUG */
+    return mhd_TLS_PROCED_SUCCESS;
+  case 1:
+    /* Externally provided TLS might not be able to distinguish between "interrupted"
+       and "try again" codes.
+       If edge-triggered sockets polling is used and the flag is cleared, but
+       it should not (because the process has been "interrupted") then already
+       pending data could be never processed.
+       If the flag is not cleared, but it should be cleared (because all
+       received data has been processed) then it would create busy-waiting loop
+       with edge-triggered sockets polling.
+       Temporal solution: disallow edge-triggered sockets polling with External TLS
+       backend and use clear of "ready" flag. */
+    return mhd_TLS_PROCED_RECV_MORE_NEEDED;
+  case 2:
+    /* Externally provided TLS might not be able to distinguish between "interrupted"
+       and "try again" codes.
+       If edge-triggered sockets polling is used and the flag is cleared, but
+       it should not (because the process has been "interrupted") then already
+       pending data could be never processed.
+       If the flag is not cleared, but it should be cleared (because all
+       received data has been processed) then it would create busy-waiting loop
+       with edge-triggered sockets polling.
+       Temporal solution: disallow edge-triggered sockets polling with External TLS
+       backend and use clear of "ready" flag. */
+    return mhd_TLS_PROCED_SEND_MORE_NEEDED;
+  default:
+    break;
+  }
+
+#ifndef NDEBUG
+  c_tls->dbg.is_failed = true;
+#endif /* ! NDEBUG */
+  return mhd_TLS_PROCED_FAILED;
+}
+
+
+/* ** Data receiving and sending ** */
+
+MHD_INTERNAL MHD_FN_PAR_NONNULL_ALL_
+MHD_FN_PAR_OUT_SIZE_ (3,2)
+MHD_FN_PAR_OUT_ (4) enum mhd_SocketError
+mhd_tls_external_conn_recv (struct mhd_TlsExternalConnData *restrict c_tls,
+                            size_t buf_size,
+                            char buf[MHD_FN_PAR_DYN_ARR_SIZE_ (buf_size)],
+                            size_t *restrict received)
+{
+  ssize_t res;
+
+  mhd_assert (c_tls->dbg.is_inited);
+  mhd_assert (c_tls->dbg.is_tls_handshake_completed);
+  mhd_assert (! c_tls->dbg.is_finished);
+  mhd_assert (! c_tls->dbg.is_failed);
+
+  /* return value limitation of INT_MAX */
+  if (buf_size > (size_t)INT_MAX)
+    buf_size = INT_MAX;
+
+  res = c_tls->cbs->conn_recv(c_tls->sess, buf, buf_size);
+
+  if (res <= 0)
+  {
+    *received = 0;
+    if (res == 0)
+    {
+      c_tls->rmt_shut_tls_wr = true;
+      return mhd_SOCKET_ERR_NO_ERROR;
+    }
+    else
+    {
+      if (res == -2)
+      {
+      /* Externally provided TLS might not be able to distinguish between "interrupted"
+         and "try again" codes.
+         If edge-triggered sockets polling is used and the flag is cleared, but
+         it should not (because the process has been "interrupted") then already
+         pending data could be never processed.
+         If the flag is not cleared, but it should be cleared (because all
+         received data has been processed) then it would create busy-waiting loop
+         with edge-triggered sockets polling.
+         Temporal solution: disallow edge-triggered sockets polling with External TLS
+         backend and use clear of "ready" flag. */
+        return mhd_SOCKET_ERR_AGAIN;
+      }
+#ifndef NDEBUG
+      c_tls->dbg.is_failed = true;
+#endif /* ! NDEBUG */
+      return mhd_SOCKET_ERR_TLS;
+    }
+  }
+
+  *received = (size_t) res;
+  return mhd_SOCKET_ERR_NO_ERROR;
+}
+
+MHD_INTERNAL MHD_FN_PAR_NONNULL_ALL_ bool
+mhd_tls_external_conn_has_data_in (struct mhd_TlsExternalConnData *restrict c_tls)
+{
+  if (NULL == c_tls->cbs || NULL == c_tls->cbs->conn_has_data_in)
+  {
+    /* If the callback is not provided, assume that there is no data */
+    return false;
+  }
+
+  return (0 != c_tls->cbs->conn_has_data_in(c_tls->sess));
+}
+
+MHD_INTERNAL MHD_FN_PAR_NONNULL_ALL_
+MHD_FN_PAR_IN_SIZE_ (3,2)
+MHD_FN_PAR_OUT_ (4) enum mhd_SocketError
+mhd_tls_external_conn_send (struct mhd_TlsExternalConnData *restrict c_tls,
+                            size_t buf_size,
+                            const char buf[MHD_FN_PAR_DYN_ARR_SIZE_ (buf_size)],
+                            size_t *restrict sent)
+{
+  ssize_t res;
+
+  mhd_assert (c_tls->dbg.is_inited);
+  mhd_assert (c_tls->dbg.is_tls_handshake_completed);
+  mhd_assert (! c_tls->dbg.is_finished);
+  mhd_assert (! c_tls->dbg.is_failed);
+
+  /* return value limitation of INT_MAX */
+  if (buf_size > (size_t)INT_MAX)
+    buf_size = INT_MAX;
+
+  res = c_tls->cbs->conn_send(c_tls->sess, buf, buf_size);
+
+  mhd_assert (0 != res);
+
+  if (res < 0)
+  {
+    *sent = 0;
+
+    if (res == -2)
+    {
+      /* Externally provided TLS might not be able to distinguish between "interrupted"
+         and "try again" codes.
+         If edge-triggered sockets polling is used and the flag is cleared, but
+         it should not (because the process has been "interrupted") then already
+         pending data could be never processed.
+         If the flag is not cleared, but it should be cleared (because all
+         received data has been processed) then it would create busy-waiting loop
+         with edge-triggered sockets polling.
+         Temporal solution: disallow edge-triggered sockets polling with External TLS
+         backend and use clear of "ready" flag. */
+      return mhd_SOCKET_ERR_AGAIN;
+    }
+
+#ifndef NDEBUG
+    c_tls->dbg.is_failed = true;
+#endif /* ! NDEBUG */
+    return mhd_SOCKET_ERR_TLS;
+  }
+
+  *sent = (size_t) res;
+  return mhd_SOCKET_ERR_NO_ERROR;
+}
+
+/* ** TLS connection information ** */
+
+MHD_INTERNAL MHD_FN_PAR_NONNULL_ALL_
+MHD_FN_PAR_OUT_ (2) void
+mhd_tls_external_conn_get_tls_sess (
+  struct mhd_TlsExternalConnData *restrict c_tls,
+  union MHD_ConnInfoDynamicTlsSess *restrict tls_sess_out)
+{
+  tls_sess_out->v_external_session = c_tls->sess;
+}
+
+MHD_INTERNAL MHD_FN_PAR_NONNULL_ALL_
+MHD_FN_PAR_OUT_ (2) bool
+mhd_tls_external_conn_get_tls_ver (struct mhd_TlsExternalConnData *restrict c_tls,
+                                   struct mhd_StctTlsVersion *restrict tls_ver_out)
+{
+  if (NULL == c_tls->cbs || NULL == c_tls->cbs->conn_get_tls_ver)
+  {
+    tls_ver_out->tls_ver = MHD_TLS_VERSION_UNKNOWN;
+    return false;
+  }
+
+  int res = c_tls->cbs->conn_get_tls_ver(c_tls->sess);
+
+  if (res < 0)
+  {
+    tls_ver_out->tls_ver = MHD_TLS_VERSION_UNKNOWN;
+    return false;
+  }
+
+  tls_ver_out->tls_ver = (enum MHD_TlsVersion) res;
+
+  return true;
+}
